# ===== QUAN TRỌNG: chỉ đặt ở Vercel → Settings → Environment Variables =====
# (hoặc `vercel env add TEN_BIEN production`). Đổi xong cần Redeploy. Không commit giá trị thật.

DATABASE_URL=                 # Vercel tự điền khi gắn Neon Postgres từ Marketplace
ADMIN_KEY=                    # mật khẩu vào /admin, /api/settings, /api/logs. Dùng chuỗi ngẫu nhiên dài
SHEET_WEBHOOK_URL=            # URL /exec của Apps Script (trống = tắt ghi Google Sheet)
SHEET_TOKEN=                  # trùng TOKEN trong Script properties của Apps Script
API_KEY=                      # tuỳ chọn: có giá trị thì chỉ ai gửi x-api-key đúng mới tạo được link
BASE_URL=                     # tuỳ chọn: vd https://s.tenmien.com, trống = tự lấy theo request

# ===== KHÔNG QUAN TRỌNG: chỉnh ở trang /admin (cần mật khẩu ADMIN_KEY) =====
# Giá trị lưu trong database. Các biến dưới đây (tuỳ chọn) chỉ là giá trị khởi tạo khi
# /admin chưa chỉnh gì. Chỉnh ở /admin luôn được ưu tiên hơn biến môi trường.
#
# QR_FOREGROUND=#000000   QR_BACKGROUND=#ffffff   QR_SIZE=512   QR_MARGIN=2
# QR_ERROR_LEVEL=M        QR_FORMAT=svg
# RATE_LIMIT_PER_MIN=0    BLOCKED_DOMAINS=bad.com,spam.net
